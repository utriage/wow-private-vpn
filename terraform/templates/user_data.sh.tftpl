#!/bin/bash
set -e

# パッケージ更新 & 必須ツールの非対話インストール
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y wireguard iptables iptables-persistent ipset curl jq

# IPフォワーディング (パケット転送) の有効化
sysctl -w net.ipv4.ip_forward=1
echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-wireguard.conf

# ネットワークインターフェース名およびパブリックIPの取得
NET_IF=$(ip route get 8.8.8.8 | awk -- '{print $5}')
SERVER_IP=$(curl -s https://checkip.amazonaws.com)

# WireGuard ディレクトリの準備
mkdir -p /etc/wireguard
chmod 700 /etc/wireguard

# ===================================================================
# Blizzard / WoW 宛先用 ipset (ハッシュセット) の構築
# ===================================================================
# Lightsail の 16KB user_data 制限対策として Base64 Gzip 圧縮された CIDR を展開
echo "${compressed_wow_cidrs}" | base64 -d | gzip -d > /tmp/wow_cidrs.txt

ipset create wow_targets hash:net -exist
while read -r cidr; do
    [ -n "$cidr" ] && ipset add wow_targets "$cidr" -exist
done < /tmp/wow_cidrs.txt

mkdir -p /etc/iptables
ipset save -file /etc/iptables/ipsets

# ===================================================================
# 防御用 PostUp / PostDown ファイアウォールスクリプトの作成
# ===================================================================
cat <<'POSTUP_EOF' > /etc/wireguard/post-up.sh
#!/bin/bash
NET_IF=$(ip route get 8.8.8.8 | awk -- '{print $5}')

# ipset がメモリ上にない場合は復元
if ! ipset list wow_targets >/dev/null 2>&1; then
    if [ -f /etc/iptables/ipsets ]; then
        ipset restore < /etc/iptables/ipsets
    fi
fi

# 1. 接続追跡 (戻りパケット) の最優先許可 (Site-to-Site 中継戻りパケットの保護)
iptables -A FORWARD -m state --state RELATED,ESTABLISHED -j ACCEPT

# 2. TCP MSS 最適化 (MTU不一致によるパケット詰まり・フラグメンテーション防止)
iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

# 3. クライアント間アイソレーション (Client Isolation)
#    メンバーPC宛て (10.0.0.0/24) への wg0 内パケット中継を即時 DROP (仲間PCの保護)
iptables -A FORWARD -i wg0 -o wg0 -d 10.0.0.0/24 -j DROP

# 4. サーバー側エグレスフィルタリング (Egress Filtering / 踏み台化・不正プロキシ化防止)
#    wg0 から外部インターネット ($NET_IF) への通信のうち、
#    宛先が Blizzard / WoW (wow_targets) 以外は即時 DROP (DNS は例外許可)
iptables -A FORWARD -i wg0 -o $NET_IF -p udp --dport 53 -j ACCEPT
iptables -A FORWARD -i wg0 -o $NET_IF -p tcp --dport 53 -j ACCEPT
iptables -A FORWARD -i wg0 -o $NET_IF -m set ! --match-set wow_targets dst -j DROP

# 5. 許可されたパケットのフォワーディング & NAT (MASQUERADE)
iptables -A FORWARD -i wg0 -j ACCEPT
iptables -t nat -A POSTROUTING -o $NET_IF -j MASQUERADE
POSTUP_EOF
chmod 700 /etc/wireguard/post-up.sh

cat <<'POSTDOWN_EOF' > /etc/wireguard/post-down.sh
#!/bin/bash
NET_IF=$(ip route get 8.8.8.8 | awk -- '{print $5}')

iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu || true
iptables -D FORWARD -i wg0 -o wg0 -d 10.0.0.0/24 -j DROP || true
iptables -D FORWARD -i wg0 -o $NET_IF -p udp --dport 53 -j ACCEPT || true
iptables -D FORWARD -i wg0 -o $NET_IF -p tcp --dport 53 -j ACCEPT || true
iptables -D FORWARD -i wg0 -o $NET_IF -m set ! --match-set wow_targets dst -j DROP || true
iptables -D FORWARD -i wg0 -j ACCEPT || true
iptables -D FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT || true
iptables -t nat -D POSTROUTING -o $NET_IF -j MASQUERADE || true
POSTDOWN_EOF
chmod 700 /etc/wireguard/post-down.sh

# サーバー秘密鍵・公開鍵の設定
SERVER_PRIV="${server_private_key}"
if [ -z "$SERVER_PRIV" ]; then
    if [ ! -f /etc/wireguard/server_private.key ]; then
        wg genkey > /etc/wireguard/server_private.key
    fi
    SERVER_PRIV=$(cat /etc/wireguard/server_private.key)
else
    echo "$SERVER_PRIV" > /etc/wireguard/server_private.key
fi
chmod 600 /etc/wireguard/server_private.key
SERVER_PUB=$(echo "$SERVER_PRIV" | wg pubkey)
echo "$SERVER_PUB" > /etc/wireguard/server_public.key

# /etc/wireguard/wg0.conf の生成
cat <<EOF > /etc/wireguard/wg0.conf
[Interface]
Address = ${vpn_ip_cidr}
ListenPort = 51820
PrivateKey = $SERVER_PRIV

# 起動・停止時のセキュアファイアウォール & NAT 制御
PostUp = /etc/wireguard/post-up.sh
PostDown = /etc/wireguard/post-down.sh

%{ for peer in peers ~}
# --- Peer: ${peer.name} ---
[Peer]
PublicKey = ${peer.public_key}
AllowedIPs = ${peer.allowed_ips}
%{ if try(peer.endpoint, "") != "" ~}
Endpoint = ${peer.endpoint}
%{ endif ~}
%{ if try(peer.persistent_keepalive, 0) > 0 ~}
PersistentKeepalive = ${peer.persistent_keepalive}
%{ endif ~}

%{ endfor ~}
EOF

# __WOW_ROUTES__ プレースホルダーが存在する場合は展開した CIDR リストで置換
if grep -q "__WOW_ROUTES__" /etc/wireguard/wg0.conf; then
    WOW_JOINED_CIDRS=$(paste -sd, /tmp/wow_cidrs.txt)
    sed -i "s|__WOW_ROUTES__|10.0.1.0/24, $WOW_JOINED_CIDRS|g" /etc/wireguard/wg0.conf
fi
rm -f /tmp/wow_cidrs.txt

chmod 600 /etc/wireguard/wg0.conf

# サービスの起動 & 自動起動登録
systemctl enable --now wg-quick@wg0

# ===================================================================
# Discord Webhook 連携 (起動完了通知 & 定期レポート)
# ===================================================================
WEBHOOK_URL="${discord_webhook_url}"
GATEWAY_NAME="${gateway_name}"
GATEWAY_ROLE="${gateway_role}"
USER_COUNT="${user_count}"
BACKBONE_NAME="${backbone_name}"
BACKBONE_PUBKEY="${backbone_pubkey}"

if [ -n "$WEBHOOK_URL" ]; then
    # 1. 起動完了通知の送信
    if [ "$GATEWAY_ROLE" = "entry" ]; then
        PAYLOAD=$(jq -n \
            --arg name "$GATEWAY_NAME" \
            --arg ip "$SERVER_IP" \
            --arg pubkey "$SERVER_PUB" \
            --arg users "$USER_COUNT" \
            --arg backbone "$BACKBONE_NAME" \
            '{
                embeds: [{
                    title: ("🚀 " + $name + " が起動完了しました"),
                    color: 5814783,
                    fields: [
                        { name: "Public IP", value: $ip, inline: true },
                        { name: "登録ユーザー数", value: ($users + " 名"), inline: true },
                        { name: "バックボーン", value: $backbone, inline: true },
                        { name: "WG Public Key", value: ("`" + $pubkey + "`") }
                    ],
                    footer: { text: "WoW Private VPN • SSH完全遮断 (Immutable)" },
                    timestamp: (now | todate)
                }]
            }')
    else
        PAYLOAD=$(jq -n \
            --arg name "$GATEWAY_NAME" \
            --arg ip "$SERVER_IP" \
            --arg pubkey "$SERVER_PUB" \
            --arg backbone "$BACKBONE_NAME" \
            '{
                embeds: [{
                    title: ("🚀 " + $name + " が起動完了しました"),
                    color: 5814783,
                    fields: [
                        { name: "Public IP", value: $ip, inline: true },
                        { name: "バックボーン", value: $backbone, inline: true },
                        { name: "WG Public Key", value: ("`" + $pubkey + "`") }
                    ],
                    footer: { text: "WoW Private VPN • SSH完全遮断 (Immutable)" },
                    timestamp: (now | todate)
                }]
            }')
    fi
    curl -s -H "Content-Type: application/json" -X POST -d "$PAYLOAD" "$WEBHOOK_URL" || true

    # 2. システムメトリクス収集スクリプトの作成 (/usr/local/bin/vpn-metric-collector.sh)
    cat <<'COLLECTOR_EOF' > /usr/local/bin/vpn-metric-collector.sh
#!/bin/bash
LOG_FILE="/var/log/vpn-metrics.log"
NOW=$(date +%s)

# Load Average (1分値)
LOAD=$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo "0.00")

# CPU使用率 (%)
CPU=$(top -bn1 | awk -F',' '/Cpu\(s\)/ {for(i=1;i<=NF;i++) if($i~/id/){gsub(/[^0-9.]/,"",$i); printf "%.1f", 100-$i; exit}}' 2>/dev/null)
if [ -z "$CPU" ]; then CPU="0.0"; fi

# メモリ使用率 (%) - (total - available) / total
MEM=$(free -m | awk '/Mem:/ {if($2>0) printf "%.1f", (($2-$7)/$2)*100; else print "0.0"}' 2>/dev/null)
if [ -z "$MEM" ]; then MEM="0.0"; fi

# ストレージ使用率 (%)
DISK=$(df / | awk 'NR==2 {gsub("%",""); print $5}' 2>/dev/null)
if [ -z "$DISK" ]; then DISK="0"; fi

echo "$NOW $LOAD $CPU $MEM $DISK" >> "$LOG_FILE"

# 48時間以上前の古いログを自動削除
CUTOFF=$(( NOW - 172800 ))
awk -v cutoff="$CUTOFF" '$1 >= cutoff' "$LOG_FILE" > "$LOG_FILE.tmp" 2>/dev/null && mv "$LOG_FILE.tmp" "$LOG_FILE"
COLLECTOR_EOF

    chmod +x /usr/local/bin/vpn-metric-collector.sh
    /usr/local/bin/vpn-metric-collector.sh || true

    # 3. 定期レポートスクリプトの作成 (/usr/local/bin/vpn-reporter.sh)
    cat <<'REPORTER_EOF' > /usr/local/bin/vpn-reporter.sh
#!/bin/bash
WEBHOOK_URL="$1"
GATEWAY_NAME="$2"
GATEWAY_ROLE="$3"
USER_COUNT="$4"
BACKBONE_NAME="$5"
BACKBONE_PUBKEY="$6"

if [ -z "$WEBHOOK_URL" ]; then exit 0; fi

WG_STATUS=$(sudo wg show wg0 dump 2>/dev/null || true)
if [ -z "$WG_STATUS" ]; then exit 0; fi

CURRENT_EPOCH=$(date +%s)
SINCE_24H=$(( CURRENT_EPOCH - 86400 ))

# 初回収集がまだの場合は即時実行
if [ ! -f /var/log/vpn-metrics.log ]; then
    /usr/local/bin/vpn-metric-collector.sh 2>/dev/null || true
fi

# 1. システムメトリクス集計 (直近24h ピーク & 平均)
METRICS_SUMMARY=$(awk -v since="$SINCE_24H" '
    $1 >= since {
        count++
        load_sum += $2; if (count == 1 || $2 > load_max) load_max = $2
        cpu_sum  += $3; if (count == 1 || $3 > cpu_max)  cpu_max  = $3
        mem_sum  += $4; if (count == 1 || $4 > mem_max)  mem_max  = $4
        cur_disk = $5;  if (count == 1 || $5 > disk_max) disk_max = $5
    }
    END {
        if (count > 0) {
            printf "• **Load (1m)**: 平均 %.2f / ピーク %.2f\n• **CPU使用率**: 平均 %.1f%% / ピーク %.1f%%\n• **メモリ使用率**: 平均 %.1f%% / ピーク %.1f%%\n• **ストレージ**: 現在 %d%% (ピーク %d%%)",
                load_sum/count, load_max,
                cpu_sum/count, cpu_max,
                mem_sum/count, mem_max,
                cur_disk, disk_max
        } else {
            printf "• メトリクス収集中 (データ蓄積中...)"
        }
    }
' /var/log/vpn-metrics.log 2>/dev/null)

if [ -z "$METRICS_SUMMARY" ]; then
    METRICS_SUMMARY="• メトリクス取得不可"
fi

# 2. WireGuard ピア通信状況の集計
# バックボーンピアは詳細表示、一般ユーザーは24h接続人数の集計として集約
BACKBONE_LINE=""
TOTAL_USERS=0
ACTIVE_USERS_24H=0
ONLINE_USERS=0

while IFS=$'\t' read -r pubkey psk endpoint allowed_ips latest_handshake transfer_rx transfer_tx keepalive; do
    if [ -z "$pubkey" ]; then continue; fi
    RX_MB=$(( transfer_rx / 1024 / 1024 ))
    TX_MB=$(( transfer_tx / 1024 / 1024 ))
    
    if [ -n "$BACKBONE_PUBKEY" ] && [ "$pubkey" = "$BACKBONE_PUBKEY" ]; then
        if [ "$latest_handshake" -gt 0 ]; then
            DIFF=$(( CURRENT_EPOCH - latest_handshake ))
            if [ "$DIFF" -lt 60 ]; then
                HS_STR="$${DIFF}秒前 (オンライン)"
            elif [ "$DIFF" -lt 3600 ]; then
                HS_STR="$(( DIFF / 60 ))分前"
            elif [ "$DIFF" -lt 86400 ]; then
                HS_STR="$(( DIFF / 3600 ))時間前"
            else
                HS_STR="$(( DIFF / 86400 ))日前"
            fi
        else
            HS_STR="未接続"
        fi
        SHORT_KEY="$${pubkey:0:6}...$${pubkey: -4}"
        FIRST_IP=$(echo "$allowed_ips" | awk -F',' '{print $1}')
        if echo "$allowed_ips" | grep -q ","; then
            DISPLAY_IPS="$FIRST_IP (+ WoW中継帯域)"
        else
            DISPLAY_IPS="$allowed_ips"
        fi
        BACKBONE_LINE="• 🌐 [バックボーン: $BACKBONE_NAME]"$'\n'"  \`$DISPLAY_IPS\` ($SHORT_KEY) | 受信: $${RX_MB}MB / 送信: $${TX_MB}MB | 最終接続: $HS_STR"
    else
        TOTAL_USERS=$(( TOTAL_USERS + 1 ))
        if [ "$latest_handshake" -gt 0 ]; then
            DIFF=$(( CURRENT_EPOCH - latest_handshake ))
            if [ "$DIFF" -le 86400 ]; then
                ACTIVE_USERS_24H=$(( ACTIVE_USERS_24H + 1 ))
            fi
            if [ "$DIFF" -lt 180 ]; then
                ONLINE_USERS=$(( ONLINE_USERS + 1 ))
            fi
        fi
    fi
done < <(echo "$WG_STATUS" | tail -n +2)

REPORT_LINES=""
if [ -n "$BACKBONE_LINE" ]; then
    REPORT_LINES+="$BACKBONE_LINE"$'\n'
fi

if [ "$TOTAL_USERS" -gt 0 ]; then
    REPORT_LINES+="• 👤 ユーザー接続: 直近24h **$${ACTIVE_USERS_24H} 名** (登録 $${TOTAL_USERS} 名 / 現在オンライン $${ONLINE_USERS} 名)"$'\n'
fi

if [ -z "$REPORT_LINES" ]; then
    REPORT_LINES="現在登録されているPeerはありません。"$'\n'
fi

# 3. 構成情報フィールドの作成
if [ "$GATEWAY_ROLE" = "entry" ]; then
    CONFIG_INFO="登録ユーザー数: $USER_COUNT 名 | バックボーン: $BACKBONE_NAME"
else
    CONFIG_INFO="バックボーン: $BACKBONE_NAME"
fi

# 4. Discord Embed ペイロード構築 & 送信 (Embedで枠線・改行・カラーを完全保護)
JSON_PAYLOAD=$(jq -n \
    --arg name "$GATEWAY_NAME" \
    --arg config "$CONFIG_INFO" \
    --arg metrics "$METRICS_SUMMARY" \
    --arg peers "$REPORT_LINES" \
    '{
        embeds: [{
            title: ("📊 " + $name + " 定期レポート"),
            color: 3066993,
            fields: [
                { name: "構成情報", value: $config, inline: false },
                { name: "🖥️ システムメトリクス (直近24h)", value: $metrics, inline: false },
                { name: "🔗 WireGuard ピア通信状況", value: $peers, inline: false }
            ],
            footer: { text: "WoW Private VPN • SSH完全遮断 (Immutable)" },
            timestamp: (now | todate)
        }]
    }')

curl -s -H "Content-Type: application/json" -X POST -d "$JSON_PAYLOAD" "$WEBHOOK_URL" || true
REPORTER_EOF

    chmod +x /usr/local/bin/vpn-reporter.sh

    # 4. crontab 登録 (5分ごとのメトリクス収集 + 1日1回 JST 00:30 / UTC 15:30 の定期レポート送信)
    (crontab -l 2>/dev/null || true; echo "*/5 * * * * /usr/local/bin/vpn-metric-collector.sh"; echo "30 15 * * * /usr/local/bin/vpn-reporter.sh '$WEBHOOK_URL' '$GATEWAY_NAME' '$GATEWAY_ROLE' '$USER_COUNT' '$BACKBONE_NAME' '$BACKBONE_PUBKEY'") | crontab -
fi
